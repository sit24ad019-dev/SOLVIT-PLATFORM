### ─── HEALTH CHECK ───
GET http://localhost:5000/api/health

### ─── GET ALL USERS ───
GET http://localhost:5000/api/users

### ─── REGISTER A USER ───
POST http://localhost:5000/api/users/register
Content-Type: application/json

{
  "id": "USR-001",
  "fullName": "Test User",
  "email": "test@example.com",
  "mobile": "9876543210",
  "password": "password123",
  "role": "citizen",
  "state": "Tamil Nadu",
  "district": "Chennai",
  "language": "English",
  "registeredAt": "2026-08-28T10:00:00.000Z"
}

### ─── LOGIN ───
POST http://localhost:5000/api/users/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123",
  "role": "citizen"
}

### ─── GET ALL COMPLAINTS ───
GET http://localhost:5000/api/complaints

### ─── CREATE A COMPLAINT ───
POST http://localhost:5000/api/complaints
Content-Type: application/json

{
  "id": "CMP-001",
  "title": "Pothole on Main Road",
  "description": "Large pothole near the signal causing traffic",
  "category": "Road",
  "location": "Main Road, Chennai",
  "district": "Chennai",
  "status": "Submitted",
  "createdAt": "2026-08-28T10:00:00.000Z",
  "userId": "USR-001",
  "userName": "Test User",
  "media": "photo.jpg",
  "timeline": [
    {
      "status": "Submitted",
      "date": "2026-08-28T10:00:00.000Z",
      "remark": "Complaint submitted successfully"
    }
  ]
}

### ─── GET ALL PETITIONS ───
GET http://localhost:5000/api/petitions

